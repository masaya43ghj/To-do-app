function createBodyCheckForm() {

  var form = FormApp.create('【お体チェック】貴女のからだの整え方をお届けします');

  form.setDescription(
    '西田美華オンラインサロン会員様限定のお体チェックフォームです✨\n' +
    'あなたの今の状態をしっかり確認して、からだの整え方をアドバイス画像でお届けします！\n' +
    '送ってくれるだけでOK🙌 一緒に理想のカラダを目指しましょう💕\n\n' +
    '回答内容は、アドバイス画像としてオンラインサロン内で会員様に共有させていただきます。\n\n' +
    '━━━━━━━━━━━━━━━━━━━━\n' +
    '⚠️ ご注意\n' +
    '━━━━━━━━━━━━━━━━━━━━\n' +
    '※本企画は、医療行為・診断・治療を目的としたものではありません。\n' +
    '体調に不安がある方、痛みや症状がある方は、必要に応じて医療機関へご相談ください。\n\n' +
    '━━━━━━━━━━━━━━━━━━━━\n' +
    '📷 写真の取り扱いについて　必ずご確認のうえ、ご応募ください\n' +
    '━━━━━━━━━━━━━━━━━━━━\n' +
    '① 写真と回答内容はサロン内で共有されます\n' +
    'いただいたお写真とアドバイス内容は、オンラインサロン会員様が閲覧できる場所で共有させていただきます。\n' +
    '公開にご同意いただける方のみ、お写真の送付をお願いいたします。\n\n' +
    '② 個人が特定されるものは写らないようご注意ください\n' +
    'お写真には、以下のものが写らないようご確認ください。\n' +
    '・お顔　・住所や建物名が分かる背景　・名札、書類、郵便物\n' +
    '・ご家族や第三者　・その他、個人が特定されるもの\n' +
    '必要に応じて、トリミングやぼかし加工をしてからお送りください。\n\n' +
    '③ 写真の使用目的について\n' +
    'お送りいただいたお写真は、本企画でのアドバイス作成、およびオンラインサロン内での共有のみに使用いたします。\n' +
    '無断で外部SNS・広告・販促物などに使用することはありません。'
  );

  // ① お名前
  form.addTextItem()
    .setTitle('① お名前（サロン内のお名前でOK）')
    .setHelpText('ニックネームでも大丈夫です🌸')
    .setRequired(true);

  // ② 所属サロン
  form.addMultipleChoiceItem()
    .setTitle('② ご所属サロン')
    .setChoiceValues(['🌸 Bloom', '🌷 Bliss'])
    .setRequired(true);

  // ③ 同意チェック（個別4項目）
  form.addCheckboxItem()
    .setTitle('③ 同意確認（全項目にチェックをお願いします）')
    .setHelpText('4つすべてにチェックが入っていない場合は受付できません。')
    .setChoiceValues([
      '本企画が医療行為・診断・治療を目的としたものではないことを理解しました。',
      '送付した写真とアドバイス内容が、オンラインサロン内で共有されることに同意します。',
      '顔・住所・名札など、個人が特定される情報が写っていないことを確認しました。',
      '送付する写真は、自分本人のものであり、第三者が写っていないことを確認しました。'
    ])
    .setRequired(true);

  // ④ 写真アップロード（GAS制限のため手動追加が必要）
  form.addSectionHeaderItem()
    .setTitle('④ 体の写真をアップロードしてください📸')
    .setHelpText(
      '【手動追加が必要です】\n' +
      'スクリプト実行後、フォーム編集画面でこの欄の下に追加してください。\n\n' +
      '追加手順：＋ボタン →「ファイルのアップロード」を選択\n' +
      '・許可するファイルの種類：画像\n' +
      '・最大サイズ：10MB\n' +
      '・必須：ON\n\n' +
      '✨ 正面・横・後ろの3枚があると◎\n' +
      '顔・個人が特定される情報は写らないようにご注意ください'
    );

  // ⑤ 気になる部位
  form.addParagraphTextItem()
    .setTitle('⑤ 気になっている部位・お悩みを教えてください')
    .setHelpText('例）お腹まわり・二の腕・脚のむくみ、など自由に書いてね')
    .setRequired(true);

  // ⑥ 一言メッセージ
  form.addParagraphTextItem()
    .setTitle('⑥ 美華さんへ一言メッセージ💌')
    .setHelpText('なんでも気軽に書いてね🩷（任意）')
    .setRequired(false);

  // 完了メッセージ
  form.setConfirmationMessage(
    '送ってくれてありがとう💕\n' +
    '美華がしっかり確認してアドバイスをお届けします！\n' +
    'しばらくお待ちください🌸'
  );

  Logger.log('✅ フォームが作成されました！');
  Logger.log('編集URL: ' + form.getEditUrl());
  Logger.log('回答URL: ' + form.getPublishedUrl());
}
